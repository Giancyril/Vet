# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT="development"

# =============================================================================
# DATABASE
# =============================================================================
# For local development with SQLite (no setup required):
DATABASE_URL="sqlite+aiosqlite:///./reviewer.db"

# Or with PostgreSQL (Recommended for production):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/code_reviewer_db"

# =============================================================================
# GOOGLE GEMINI API
# =============================================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# =============================================================================
# GITHUB APP CREDENTIALS
# =============================================================================
# Generated when creating your GitHub App in GitHub Developer Settings
GITHUB_APP_ID="123456"
GITHUB_WEBHOOK_SECRET="your-webhook-secret-here"

# Path to the private key .pem file or inline PEM content
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# =============================================================================
# FRONTEND / CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
